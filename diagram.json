	"connections": [
		["uno:9", "panServo:PWM", "green", []],
		["uno:5V", "panServo:V+", "red", []],
		["uno:GND.2", "panServo:GND", "black", []],

		["uno:10", "tiltServo:PWM", "green", []],
		["uno:5V", "tiltServo:V+", "red", []],
		["uno:GND.2", "tiltServo:GND", "black", []],

		["uno:A4", "rtc:SDA", "blue", []],
