		["esp:GND", "panServo:GND", "black", []],

		["esp:D1", "tiltServo:PWM", "green", []],
		["esp:5V", "tiltServo:V+", "red", []],
		["esp:GND", "tiltServo:GND", "black", []],

		["esp:D4", "rtc:SDA", "blue", []],
		["esp:D5", "rtc:SCL", "yellow", []],
		["esp:5V", "rtc:5V", "red", []],
		["esp:GND", "rtc:GND", "black", []],

		["esp:D7", "armSwitch:2", "blue", []],
		["esp:GND", "armSwitch:1", "black", []],

		["esp:D3", "lampResistor:1", "orange", []],
		["lampResistor:2", "lampLed:A", "orange", ["h106.2", "v16.35"]],
		["lampLed:C", "esp:GND", "black", []]
