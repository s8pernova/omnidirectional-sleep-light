			"type": "wokwi-arduino-uno",
			"id": "uno",
			"top": 0,
			"left": 0,
			"attrs": {}
		},
		{
			"type": "wokwi-servo",
			"id": "panServo",
			"top": 20,
			"left": 450,
			"attrs": { "horn": "double", "hornColor": "#ff8fab" }
		},
		{
			"type": "wokwi-servo",
			"id": "tiltServo",
			"top": 180,
			"left": 450,
			"attrs": { "horn": "double", "hornColor": "#bde0fe" }
		},
		{
			"type": "wokwi-ds1307",
