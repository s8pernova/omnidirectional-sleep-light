			"left": 30,
			"attrs": { "lux": "10" }
		},
		{
			"type": "wokwi-slide-switch",
			"id": "armSwitch",
			"top": 450,
			"left": 300,
			"attrs": {}
		},
		{
			"type": "wokwi-resistor",
			"id": "lampResistor",
			"top": 450,
			"left": 470,
			"rotate": 90,
			"attrs": { "value": "220" }
		},
		{
			"type": "wokwi-led",
			"id": "lampLed",
