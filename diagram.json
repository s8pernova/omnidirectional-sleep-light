				"psramType": "octal",
				"serialInterface": "USB_SERIAL_JTAG"
			}
		},
		{
			"type": "wokwi-text",
			"id": "cameraNote",
			"top": -60,
			"left": -45,
			"attrs": {
				"text": "U1 XIAO ESP32-S3 Sense\nCamera input not simulated"
			}
		},
		{
			"type": "wokwi-servo",
