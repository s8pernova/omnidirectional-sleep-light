		{
			"type": "wokwi-text",
			"id": "panServoLabel",
			"top": 105,
			"left": 470,
			"attrs": { "text": "M1 Pan servo" }
		},
		{
			"type": "wokwi-servo",
			"id": "tiltServo",
			"top": 180,
			"left": 450,
			"attrs": { "horn": "double", "hornColor": "#bde0fe" }
		},
		{
			"type": "wokwi-text",
			"id": "tiltServoLabel",
