		["uno:5V", "rtc:5V", "red", []],
		["uno:GND.2", "rtc:GND", "black", []],

		["uno:A0", "lightSensor:AO", "purple", []],
		["uno:5V", "lightSensor:VCC", "red", []],
		["uno:GND.2", "lightSensor:GND", "black", []],

		["uno:2", "armSwitch:2", "blue", []],
		["uno:GND.2", "armSwitch:1", "black", []],

		["uno:5", "lampResistor:1", "orange", []],
		["lampResistor:2", "lampLed:A", "orange", []],
